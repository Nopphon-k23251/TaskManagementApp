rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Tasks collection: Allow logged-in users to manage tasks
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;
    }

    // Default rule for all other documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
